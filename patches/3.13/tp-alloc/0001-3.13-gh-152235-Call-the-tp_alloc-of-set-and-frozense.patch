diff --git a/Misc/NEWS.d/next/Core_and_Builtins/2026-11-19-16-20-00.gh-issue-152235.GL4RD4.rst b/Misc/NEWS.d/next/Core_and_Builtins/2026-11-19-16-20-00.gh-issue-152235.GL4RD4.rst
new file mode 100644
index 0000000..7827509
--- /dev/null
+++ b/Misc/NEWS.d/next/Core_and_Builtins/2026-11-19-16-20-00.gh-issue-152235.GL4RD4.rst
@@ -0,0 +1,4 @@
+Building a :class:`set` or :class:`frozenset` subclass written in C from an
+iterable calls the subclass's :c:member:`~PyTypeObject.tp_alloc` again, and
+the :c:member:`~PyTypeObject.tp_alloc` slot of :class:`set` and
+:class:`frozenset` is :c:func:`PyType_GenericAlloc` again.
diff --git a/Modules/_testcapi/set.c b/Modules/_testcapi/set.c
index 31b52ce..a6419e9 100644
--- a/Modules/_testcapi/set.c
+++ b/Modules/_testcapi/set.c
@@ -8,8 +8,41 @@ set_get_size(PyObject *self, PyObject *obj)
     RETURN_SIZE(PySet_GET_SIZE(obj));
 }
 
+// gh-152235: subclasses of set and frozenset with their own tp_alloc.
+static Py_ssize_t custom_alloc_calls = 0;
+
+static PyObject *
+counting_alloc(PyTypeObject *type, Py_ssize_t nitems)
+{
+    custom_alloc_calls++;
+    return PyType_GenericAlloc(type, nitems);
+}
+
+static PyObject *
+set_custom_alloc_calls(PyObject *self, PyObject *Py_UNUSED(ignored))
+{
+    return PyLong_FromSsize_t(custom_alloc_calls);
+}
+
+static PyTypeObject SetWithCustomAlloc_Type = {
+    PyVarObject_HEAD_INIT(NULL, 0)
+    .tp_name = "_testcapi.SetWithCustomAlloc",
+    .tp_basicsize = sizeof(PySetObject),
+    .tp_flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE,
+    .tp_alloc = counting_alloc,
+};
+
+static PyTypeObject FrozenSetWithCustomAlloc_Type = {
+    PyVarObject_HEAD_INIT(NULL, 0)
+    .tp_name = "_testcapi.FrozenSetWithCustomAlloc",
+    .tp_basicsize = sizeof(PySetObject),
+    .tp_flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE,
+    .tp_alloc = counting_alloc,
+};
+
 static PyMethodDef test_methods[] = {
     {"set_get_size", set_get_size, METH_O},
+    {"set_custom_alloc_calls", set_custom_alloc_calls, METH_NOARGS},
 
     {NULL},
 };
@@ -20,6 +53,13 @@ _PyTestCapi_Init_Set(PyObject *m)
     if (PyModule_AddFunctions(m, test_methods) < 0) {
         return -1;
     }
-
+    SetWithCustomAlloc_Type.tp_base = &PySet_Type;
+    if (PyModule_AddType(m, &SetWithCustomAlloc_Type) < 0) {
+        return -1;
+    }
+    FrozenSetWithCustomAlloc_Type.tp_base = &PyFrozenSet_Type;
+    if (PyModule_AddType(m, &FrozenSetWithCustomAlloc_Type) < 0) {
+        return -1;
+    }
     return 0;
 }
diff --git a/Objects/setobject.c b/Objects/setobject.c
index b61c91f..d57a778 100644
--- a/Objects/setobject.c
+++ b/Objects/setobject.c
@@ -1088,7 +1088,18 @@ make_new_set_untracked(PyTypeObject *type, PyObject *iterable)
     assert(PyType_Check(type));
     PySetObject *so;
 
-    so = (PySetObject *)_PyType_AllocNoTrack(type, 0);
+    if (type->tp_alloc == PyType_GenericAlloc) {
+        so = (PySetObject *)_PyType_AllocNoTrack(type, 0);
+    }
+    else {
+        // A subclass written in C with its own allocator, which returns
+        // zeroed memory too: use it, but keep the set untracked until it is
+        // full, like the others.
+        so = (PySetObject *)type->tp_alloc(type, 0);
+        if (so != NULL && _PyObject_GC_IS_TRACKED(so)) {
+            _PyObject_GC_UNTRACK(so);
+        }
+    }
     if (so == NULL)
         return NULL;
 
@@ -2541,7 +2552,7 @@ PyTypeObject PySet_Type = {
     0,                                  /* tp_descr_set */
     0,                                  /* tp_dictoffset */
     (initproc)set_init,                 /* tp_init */
-    _PyType_AllocNoTrack,               /* tp_alloc */
+    PyType_GenericAlloc,                /* tp_alloc */
     set_new,                            /* tp_new */
     PyObject_GC_Del,                    /* tp_free */
     .tp_vectorcall = set_vectorcall,
@@ -2632,7 +2643,7 @@ PyTypeObject PyFrozenSet_Type = {
     0,                                  /* tp_descr_set */
     0,                                  /* tp_dictoffset */
     0,                                  /* tp_init */
-    _PyType_AllocNoTrack,               /* tp_alloc */
+    PyType_GenericAlloc,                /* tp_alloc */
     frozenset_new,                      /* tp_new */
     PyObject_GC_Del,                    /* tp_free */
     .tp_vectorcall = frozenset_vectorcall,
