From cdfa29944fce4197fe285f92ef9d2e0f7393f285 Mon Sep 17 00:00:00 2001
From: Adrin Jalali <adrin.jalali@gmail.com>
Date: Thu, 19 Nov 2026 16:00:53 +0000
Subject: [PATCH] [3.13] gh-152235: Call the tp_alloc of set and frozenset
 subclasses again

Since gh-152235, make_new_set() allocates with _PyType_AllocNoTrack()
instead of type->tp_alloc, so a subclass of set or frozenset written in C
with its own tp_alloc no longer has its allocator called when it is built,
while its tp_free still releases the object.  The tp_alloc slot of set
and frozenset, which such subclasses inherit, also became
_PyType_AllocNoTrack(), which returns untracked objects.

Call type->tp_alloc again when it isn't PyType_GenericAlloc, and untrack
the result until the set is full, as the other paths do.  Exact sets and
Python subclasses keep the direct _PyType_AllocNoTrack() path.  Make
PyType_GenericAlloc the tp_alloc of set and frozenset again.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Lib/test/test_capi/test_set.py                | 12 ++++++
 Misc/ACKS                                     |  1 +
 ...-11-19-16-20-00.gh-issue-152235.GL4RD4.rst |  4 ++
 Modules/_testcapi/set.c                       | 42 ++++++++++++++++++-
 Objects/setobject.c                           | 17 ++++++--
 5 files changed, 72 insertions(+), 4 deletions(-)
 create mode 100644 Misc/NEWS.d/next/Core_and_Builtins/2026-11-19-16-20-00.gh-issue-152235.GL4RD4.rst

diff --git a/Lib/test/test_capi/test_set.py b/Lib/test/test_capi/test_set.py
index 62d90a3..4bbd6d9 100644
--- a/Lib/test/test_capi/test_set.py
+++ b/Lib/test/test_capi/test_set.py
@@ -1,3 +1,4 @@
+import gc
 import unittest
 
 from test.support import import_helper
@@ -219,6 +220,17 @@ def test_clear(self):
         self.assertImmutable(clear)
         # CRASHES: clear(NULL)
 
+    def test_subclass_with_custom_tp_alloc(self):
+        # gh-152235: building one from an iterable calls its tp_alloc.
+        for cls in (_testcapi.SetWithCustomAlloc,
+                    _testcapi.FrozenSetWithCustomAlloc):
+            with self.subTest(cls=cls):
+                calls = _testcapi.set_custom_alloc_calls()
+                s = cls(x for x in range(3))
+                self.assertEqual(_testcapi.set_custom_alloc_calls(), calls + 1)
+                self.assertEqual(s, {0, 1, 2})
+                self.assertTrue(gc.is_tracked(s))
+
 
 class TestInternalCAPI(BaseSetTests, unittest.TestCase):
     def test_set_update(self):
diff --git a/Misc/ACKS b/Misc/ACKS
index 1c80bef..361c82f 100644
--- a/Misc/ACKS
+++ b/Misc/ACKS
@@ -869,6 +869,7 @@ Jeffrey C. Jacobs
 Kevin Jacobs
 Kjetil Jacobsen
 Shantanu Jain
+Adrin Jalali
 Bertrand Janin
 Geert Jansen
