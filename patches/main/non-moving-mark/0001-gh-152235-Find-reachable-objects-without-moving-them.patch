From e54c7fcc9ae867cbae61fd4a462c0c4ae7d1d7ea Mon Sep 17 00:00:00 2001
From: Adrin Jalali <adrin.jalali@gmail.com>
Date: Tue, 17 Nov 2026 20:34:34 +0000
Subject: [PATCH] gh-152235: Find reachable objects without moving them in the
 GC

move_unreachable() moved every object with gc_refs 0 to 'unreachable',
and moved it back, in its referrer's traversal order, if the referrer
turned out to be reachable.  For a set that is hash order: its elements
end up in random memory order in the GC list, and every later full
collection is up to ten times slower.  This happens to a set built from
a generator (since gh-152235 only tracks it once it is full) and to one
built from a list or dict that then goes away (in every version).

Mark reachable objects in place instead.  Scan 'young' in order and
traverse objects with gc_refs > 0; flag the others with
NEXT_MASK_UNREACHABLE where they are, and traverse a flagged object from
a stack when a later object reaches it.  A final pass moves the flagged
objects to 'unreachable'.  Reachable objects keep their order.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Lib/test/test_gc.py                           |  15 ++
 Misc/ACKS                                     |   1 +
 ...-11-17-20-16-11.gh-issue-152235.fmFd6y.rst |   5 +
 Python/gc.c                                   | 202 +++++++-----------
 4 files changed, 98 insertions(+), 125 deletions(-)
 create mode 100644 Misc/NEWS.d/next/Core_and_Builtins/2026-11-17-20-16-11.gh-issue-152235.fmFd6y.rst

diff --git a/Lib/test/test_gc.py b/Lib/test/test_gc.py
index 919100f2d5c..ee10c4c4c9a 100644
--- a/Lib/test/test_gc.py
+++ b/Lib/test/test_gc.py
@@ -899,6 +899,21 @@ def test_get_objects(self):
                 any(l is element for element in gc.get_objects())
         )
 
+    @requires_gil_enabled('need generational GC')
+    def test_collection_keeps_list_order(self):
+        # gh-152235: a collection doesn't reorder reachable objects, even ones
+        # whose only referrer comes after them in the list (here, a set built
+        # from a list that went away).
+        class K:
+            pass
+        with support.disable_gc():
+            s = set([K() for _ in range(1000)])
+            before = [id(o) for o in gc.get_objects() if type(o) is K]
+        gc.collect()
+        after = [id(o) for o in gc.get_objects() if type(o) is K]
+        self.assertEqual(len(after), len(s))
+        self.assertEqual(after, before)
+
     @requires_gil_enabled('need generational GC')
     def test_get_objects_generations(self):
         gc.collect()
