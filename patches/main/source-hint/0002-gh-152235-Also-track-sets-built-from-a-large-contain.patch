diff --git a/Misc/NEWS.d/next/Core_and_Builtins/2026-11-17-20-16-11.gh-issue-152235.CuViYU.rst b/Misc/NEWS.d/next/Core_and_Builtins/2026-11-17-20-16-11.gh-issue-152235.CuViYU.rst
