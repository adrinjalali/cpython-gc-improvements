                          for i, o in enumerate(gc.get_objects(generation=0))}
                 self.assertLess(order[id(s)], min(order[id(e)] for e in s))
 
+    @support.requires_gil_enabled("the free-threaded GC has no list order")
+    def test_tracked_ahead_of_source_elements(self):
+        # A set built from a large container that then goes away takes the
+        # container's place in the GC list, ahead of the elements.  (A dict is
+        # only tracked once it holds its first element.)
+        for name, make, allowed in (('list', list, 0), ('dict', dict.fromkeys, 1)):
+            with self.subTest(name), support.disable_gc():
+                source = make(Elem(i) for i in range(2000))
+                s = set(source)
+                del source
+                order = {id(o): i
+                         for i, o in enumerate(gc.get_objects(generation=0))}
+                behind = sum(order[id(e)] < order[id(s)] for e in s)
+                self.assertLessEqual(behind, allowed)
+
     def test_not_reachable_while_filled(self):
         for name, build in self.builders().items():
             with self.subTest(name):
