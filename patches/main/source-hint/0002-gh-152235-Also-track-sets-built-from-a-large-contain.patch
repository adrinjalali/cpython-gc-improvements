+++ b/Misc/NEWS.d/next/Core_and_Builtins/2026-11-17-20-16-11.gh-issue-152235.CuViYU.rst
@@ -0,0 +1,6 @@
+Fix full garbage collections becoming up to ten times slower after a large
+:class:`set` or :class:`frozenset` is built from an iterator that creates its
+elements, such as a generator, or from a large list, tuple or dict that then
+goes away.  The new set is tracked by the garbage collector ahead of the
+elements, and is still not reachable through :func:`gc.get_objects` until it
+is complete.
diff --git a/Objects/setobject.c b/Objects/setobject.c
index dab173f6c49..4409135adb8 100644
--- a/Objects/setobject.c
+++ b/Objects/setobject.c
@@ -1395,16 +1395,51 @@ fill_may_create_tracked_elements(PyTypeObject *tp)
 // reserve the set's place in the GC list ahead of them before the fill, or
 // a full collection scatters them in memory.  An iterator is already ahead of
 // everything it yields, so it can lend its position.
+//
+// A set filled from a large container may also become the only owner of the
+// elements, once the container goes away (s = set(big_list); del big_list):
+// a full collection then scatters them the same way.  The container was
+// usually tracked ahead of the elements it holds, so it lends its position
+// too.  Small sets are left alone: scattered or not, they fit in a cache.
+#define SET_SOURCE_POSITION_MIN_SIZE 1024
+
+static inline int
+use_source_position(PyObject *iterable)
+{
+    Py_ssize_t n;
+    if (PyList_Check(iterable)) {
+        n = PyList_GET_SIZE(iterable);
+    }
+    else if (PyTuple_Check(iterable)) {
+        n = PyTuple_GET_SIZE(iterable);
+    }
+    else if (PyDict_Check(iterable)) {
+        n = PyDict_GET_SIZE(iterable);
+    }
+    else if (PySet_CheckExact(iterable) || PyFrozenSet_CheckExact(iterable)) {
+        n = PySet_GET_SIZE(iterable);
+    }
+    else {
+        return 0;
+    }
+    return n >= SET_SOURCE_POSITION_MIN_SIZE
+           && _PyObject_GC_IS_TRACKED(iterable);
+}
+
 static int
 reserve_gc_position(PyObject *iterable, _PyGC_Position *pos)
 {
-    if (iterable == NULL
-        || !fill_may_create_tracked_elements(Py_TYPE(iterable)))
-    {
+    if (iterable == NULL) {
         return 0;
     }
-    PyObject *hint = PyIter_Check(iterable) ? iterable : NULL;
-    return _PyGC_ReservePosition(pos, hint);
+    if (fill_may_create_tracked_elements(Py_TYPE(iterable))) {
+        PyObject *hint = PyIter_Check(iterable) ? iterable : NULL;
+        return _PyGC_ReservePosition(pos, hint);
+    }
+    if (use_source_position(iterable)) {
+        return _PyGC_ReservePosition(pos, iterable);
+    }
+    return 0;
 }
 
 // _PyObject_GC_TrackAtPosition() handles an unreserved position too, but
@@ -1440,7 +1475,8 @@ static PyObject *
 make_new_set(PyTypeObject *type, PyObject *iterable)
 {
     if (iterable != NULL
-        && fill_may_create_tracked_elements(Py_TYPE(iterable)))
+        && (fill_may_create_tracked_elements(Py_TYPE(iterable))
+            || use_source_position(iterable)))
     {
         return make_new_set_at_gc_position(type, iterable);
     }
