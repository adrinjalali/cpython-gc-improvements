@@ -0,0 +1,5 @@
+Fix full garbage collections becoming up to ten times slower after a large
+:class:`set` or :class:`frozenset` is built from an iterator that creates its
+elements, such as a generator.  The new set is again tracked by the garbage
+collector ahead of those elements, and is still not reachable through
+:func:`gc.get_objects` until it is complete.
diff --git a/Objects/setobject.c b/Objects/setobject.c
index c6ceebeb099..dab173f6c49 100644
--- a/Objects/setobject.c
+++ b/Objects/setobject.c
@@ -1373,9 +1373,77 @@ make_new_set_untracked(PyTypeObject *type, PyObject *iterable)
     return (PyObject *)so;
 }
 
+// A set filled from these only gets elements that already exist (so are
+// already ahead of the set in the GC list) or that the GC doesn't track.
+static inline int
+fill_may_create_tracked_elements(PyTypeObject *tp)
+{
+    if (tp->tp_flags & (Py_TPFLAGS_LIST_SUBCLASS
+                        | Py_TPFLAGS_TUPLE_SUBCLASS
+                        | Py_TPFLAGS_DICT_SUBCLASS
+                        | Py_TPFLAGS_UNICODE_SUBCLASS))
+    {
+        return 0;
+    }
+    return !(tp == &PySet_Type || tp == &PyFrozenSet_Type ||
+             tp == &PyRange_Type || tp == &PyDictKeys_Type ||
+             tp == &PyDictValues_Type);
+}
+
+// gh-152235: a set is tracked only once it is filled, so that it can't be
+// found half-built.  If the fill creates the elements, as a generator does,
+// reserve the set's place in the GC list ahead of them before the fill, or
+// a full collection scatters them in memory.  An iterator is already ahead of
+// everything it yields, so it can lend its position.
+static int
+reserve_gc_position(PyObject *iterable, _PyGC_Position *pos)
+{
+    if (iterable == NULL
+        || !fill_may_create_tracked_elements(Py_TYPE(iterable)))
+    {
+        return 0;
+    }
+    PyObject *hint = PyIter_Check(iterable) ? iterable : NULL;
+    return _PyGC_ReservePosition(pos, hint);
+}
+
+// _PyObject_GC_TrackAtPosition() handles an unreserved position too, but
+// this keeps the common case inline.
+static inline void
+track_set_at(PyObject *so, _PyGC_Position *pos)
+{
+    if (pos->anchor != NULL) {
+        _PyObject_GC_TrackAtPosition(so, pos);
+    }
+    else {
+        _PyObject_GC_TRACK(so);
+    }
+}
+
+static PyObject *
+make_new_set_at_gc_position(PyTypeObject *type, PyObject *iterable)
+{
+    _PyGC_Position pos = _PyGC_POSITION_INIT;
+    if (reserve_gc_position(iterable, &pos) < 0) {
+        return NULL;
+    }
+    PyObject *so = make_new_set_untracked(type, iterable);
+    if (so == NULL) {
+        _PyGC_ReleasePosition(&pos);
+        return NULL;
+    }
+    track_set_at(so, &pos);
+    return so;
+}
+
