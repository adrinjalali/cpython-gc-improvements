diff --git a/Lib/test/test_set.py b/Lib/test/test_set.py
index 54d229b71de..8fa0a09e0a2 100644
--- a/Lib/test/test_set.py
+++ b/Lib/test/test_set.py
@@ -2235,6 +2235,97 @@ def test_cuboctahedron(self):
                 self.assertIn(cubevert, g)
 
 
+#==============================================================================
+
+class Elem:
+    def __init__(self, value):
+        self.value = value
+    def __hash__(self):
+        return hash(self.value)
+    def __eq__(self, other):
+        return isinstance(other, Elem) and self.value == other.value
+
+
+class Iterable:
+    # Not an iterator itself.
+    def __init__(self, iterator):
+        self.iterator = iterator
+    def __iter__(self):
+        return self.iterator
+
+
+@support.cpython_only
+class TestGCTracking(unittest.TestCase):
+    # gh-152235: a set filled from an iterable isn't reachable through the GC
+    # until it is complete, but is tracked ahead of the elements the fill
+    # created, so that full collections don't scatter them in memory.
+
+    def builders(self):
+        base = set(map(Elem, range(100)))
+        return {
+            'set': set,
+            'frozenset': frozenset,
+            'set(non-iterator)': lambda it: set(Iterable(it)),
+            'union': set().union,
+            'intersection': base.intersection,
+            'symmetric_difference': set().symmetric_difference,
+        }
+
+    @support.requires_gil_enabled("the free-threaded GC has no list order")
+    def test_tracked_ahead_of_new_elements(self):
+        for name, build in self.builders().items():
+            with self.subTest(name), support.disable_gc():
+                s = build(Elem(i) for i in range(100))
+                order = {id(o): i
+                         for i, o in enumerate(gc.get_objects(generation=0))}
+                self.assertLess(order[id(s)], min(order[id(e)] for e in s))
+
+    def test_not_reachable_while_filled(self):
+        for name, build in self.builders().items():
+            with self.subTest(name):
+                first = Elem(0)
+                found = []
+                def gen():
+                    yield first
+                    found.extend(r for r in gc.get_referrers(first)
+                                 if isinstance(r, (set, frozenset)))
+                    yield from map(Elem, range(1, 100))
+                s = build(gen())
+                self.assertIn(first, s)
+                self.assertEqual(found, [])
+
+    @support.requires_gil_enabled("the free-threaded GC has no list order")
+    def test_freeze_during_fill(self):
+        # The iterator is frozen while it is consumed: the set must not be
+        # tracked next to it, in the permanent generation.
+        def gen():
+            yield Elem(0)
+            gc.freeze()
+            yield Elem(1)
+        try:
+            s = set(gen())
+            self.assertIn(id(s), {id(o) for o in gc.get_objects()})
+        finally:
+            gc.unfreeze()
+
+    def test_fill_from_garbage_in_finalizer(self):
+        # A finalizer run by a collection fills a set from an iterator that
+        # is garbage in that same collection.
+        results = []
+        class Holder:
+            def __init__(self):
+                self.iterator = map(Elem, range(10))
+                self.cycle = self
+            def __del__(self):
+                results.append(set(self.iterator))
+        Holder()
+        gc.collect()
+        gc.collect()
+        self.assertEqual(len(results), 1)
+        self.assertEqual(results[0], set(map(Elem, range(10))))
+        self.assertTrue(gc.is_tracked(results[0]))
+
+
 #==============================================================================
 
