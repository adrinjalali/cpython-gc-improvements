diff --git a/Include/internal/pycore_gc.h b/Include/internal/pycore_gc.h
index 33f94c0a0ad..1650704eb72 100644
--- a/Include/internal/pycore_gc.h
+++ b/Include/internal/pycore_gc.h
@@ -286,6 +286,45 @@ static inline void _PyObject_GC_UNTRACK(
 #endif
 }
 
+/* Track an object at a position reserved before it was filled in.
+ *
+ * A container that is only tracked once it is complete, so that it can't be
+ * reached half-built (for example through gc.get_objects()), ends up behind
+ * the objects created while it was filled.  A full collection then meets
+ * those objects first and, once it reaches the container, moves them back in
+ * its traversal order.  For a set that is hash order, which scatters the
+ * elements in memory and makes later collections much slower (gh-152235).
+ * Reserving a position before the fill keeps the list in creation order:
+ *
+ *     _PyGC_Position pos = _PyGC_POSITION_INIT;
+ *     if (_PyGC_ReservePosition(&pos, hint) < 0) {
+ *         return NULL;
+ *     }
+ *     ... fill op, which is not tracked ...
+ *     _PyObject_GC_TrackAtPosition(op, &pos);  // or _PyGC_ReleasePosition()
+ *
+ * 'hint' may be NULL, or an object that is ahead in the GC list of everything
+ * the fill creates, such as the iterator being consumed: its position is used
+ * when that is safe, and otherwise a placeholder is tracked.  An unreserved
+ * position tracks the object normally.  In the free-threaded build, where
+ * objects are not kept in lists, these track the object normally too.
+ */
+typedef struct {
+    PyObject *anchor;   // strong reference, or NULL
+    int is_placeholder;
+} _PyGC_Position;
+
+#define _PyGC_POSITION_INIT {NULL, 0}
+
+// Return 0 on success, or -1 with an exception set.
+extern int _PyGC_ReservePosition(_PyGC_Position *pos, PyObject *hint);
+
+// Release a reserved position without tracking anything.
+extern void _PyGC_ReleasePosition(_PyGC_Position *pos);
+
+// Track op, which must not be tracked, at pos, and release pos.
+extern void _PyObject_GC_TrackAtPosition(PyObject *op, _PyGC_Position *pos);
+
 
 
