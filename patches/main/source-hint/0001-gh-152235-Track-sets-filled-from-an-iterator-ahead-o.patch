diff --git a/Python/gc.c b/Python/gc.c
index e363fa77f72..753c1e5b21b 100644
--- a/Python/gc.c
+++ b/Python/gc.c
@@ -237,6 +237,23 @@ gc_list_append(PyGC_Head *node, PyGC_Head *list)
     list->_gc_prev = (uintptr_t)node;
 }
 
+/* Insert `node` right after `prev`, in the gc list `prev` is in.  Unlike
+ * gc_list_append(), `prev` may be an object (whose _gc_prev has flags).
+ */
+static inline void
+gc_list_insert_after(PyGC_Head *node, PyGC_Head *prev)
+{
+    PyGC_Head *next = GC_NEXT(prev);
+
+    // prev <-> node
+    _PyGCHead_SET_PREV(node, prev);
+    _PyGCHead_SET_NEXT(prev, node);
+
+    // node <-> next
+    _PyGCHead_SET_NEXT(node, next);
+    _PyGCHead_SET_PREV(next, node);
+}
+
 /* Remove `node` from the gc list it's currently in. */
 static inline void
 gc_list_remove(PyGC_Head *node)
@@ -1818,6 +1835,67 @@ _PyGC_GetFreezeCount(PyInterpreterState *interp)
     return gc_list_size(&gcstate->permanent_generation.head);
 }
 
+/* Tracking at a reserved position: see _PyGC_Position in pycore_gc.h. */
+
+int
+_PyGC_ReservePosition(_PyGC_Position *pos, PyObject *hint)
+{
+    GCState *gcstate = get_gc_state();
+    assert(pos->anchor == NULL);
+    // A hint that gc.freeze() moved to the permanent generation would take
+    // the object there too, and it would never be collected.  We can't tell
+    // where an object is, so only use a hint when nothing is frozen.
+    if (hint != NULL && _PyObject_IS_GC(hint) && _PyObject_GC_IS_TRACKED(hint)
+        && gc_list_is_empty(&gcstate->permanent_generation.head))
+    {
+        pos->anchor = Py_NewRef(hint);
+        pos->is_placeholder = 0;
+        return 0;
+    }
+    // A list is always tracked, and harmless if found through
+    // gc.get_objects().  It is only referenced from here, so it moves through
+    // the generations as an object tracked now would.
+    pos->anchor = PyList_New(0);
+    if (pos->anchor == NULL) {
+        return -1;
+    }
+    pos->is_placeholder = 1;
+    return 0;
+}
+
+void
+_PyGC_ReleasePosition(_PyGC_Position *pos)
+{
+    Py_CLEAR(pos->anchor);
+}
+
+void
+_PyObject_GC_TrackAtPosition(PyObject *op, _PyGC_Position *pos)
+{
+    GCState *gcstate = get_gc_state();
+    PyObject *anchor = pos->anchor;
+    _PyObject_ASSERT(op, !_PyObject_GC_IS_TRACKED(op));
+    // Use the anchor's position unless:
+    // - it is no longer tracked;
+    // - it is in a list being collected: Python code run by a collection
+    //   (a finalizer, say) can fill an object from garbage the collection
+    //   is about to clear;
+    // - it is a hint and gc.freeze() was called since it was reserved.
+    if (anchor != NULL
+        && _PyObject_GC_IS_TRACKED(anchor)
+        && !gc_is_collecting(AS_GC(anchor))
+        && (pos->is_placeholder
+            || gc_list_is_empty(&gcstate->permanent_generation.head)))
+    {
+        gc_list_insert_after(AS_GC(op), AS_GC(anchor));
+        gcstate->heap_size++;
+    }
+    else {
+        _PyObject_GC_TRACK(op);
+    }
+    _PyGC_ReleasePosition(pos);
+}
+
 /* C API for controlling the state of the garbage collector */
 int
 PyGC_Enable(void)
diff --git a/Python/gc_free_threading.c b/Python/gc_free_threading.c
index f4f1a7777f3..bf7225fafb4 100644
--- a/Python/gc_free_threading.c
+++ b/Python/gc_free_threading.c
@@ -2575,6 +2575,30 @@ _PyGC_GetFreezeCount(PyInterpreterState *interp)
     return args.count;
 }
 
+/* Tracking at a reserved position: see _PyGC_Position in pycore_gc.h.  The
+   free-threaded GC doesn't keep objects in lists, so there is no position to
+   keep: objects are tracked normally. */
+
+int
+_PyGC_ReservePosition(_PyGC_Position *pos, PyObject *Py_UNUSED(hint))
+{
+    assert(pos->anchor == NULL);
+    return 0;
+}
+
+void
+_PyGC_ReleasePosition(_PyGC_Position *pos)
+{
+    Py_CLEAR(pos->anchor);
+}
+
+void
+_PyObject_GC_TrackAtPosition(PyObject *op, _PyGC_Position *pos)
+{
+    _PyObject_GC_TRACK(op);
+    _PyGC_ReleasePosition(pos);
+}
+
 /* C API for controlling the state of the garbage collector */
 int
 PyGC_Enable(void)
