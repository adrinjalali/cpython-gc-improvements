@@ -0,0 +1,5 @@
+Fix full garbage collections becoming up to ten times slower after a large
+:class:`set` or :class:`frozenset` is built from an iterator that creates its
+elements, such as a generator.  The new set is again tracked by the garbage
+collector ahead of those elements, and is still not reachable through
+:func:`gc.get_objects` until it is complete.
diff --git a/Objects/setobject.c b/Objects/setobject.c
index c6ceebeb099..f3a873c2952 100644
--- a/Objects/setobject.c
+++ b/Objects/setobject.c
@@ -1373,9 +1373,92 @@ make_new_set_untracked(PyTypeObject *type, PyObject *iterable)
     return (PyObject *)so;
 }
 
+/* gh-152235: a set is tracked only once it is filled, so that it can't be
+   found half-built.  If the fill creates the elements, as a generator does,
+   the set would then be behind them in the GC list, and a full collection
+   would move them back in hash order, scattering them in memory.  So for such
+   fills an empty set is tracked first, ahead of the elements; the fill goes to
+   a private set; and the contents are moved into the empty set at the end.
+   The empty set can only have been reached through the GC: if it was kept or
+   changed meanwhile, it is left as it is and the private set is used. */
+
+// Whether a fill from 'iterable' may create GC-tracked elements.  A set filled
+// from these only gets elements that already exist (so are already ahead of
+// it in the GC list) or that the GC doesn't track.
+static inline int
+fill_may_create_tracked_elements(PyObject *iterable)
+{
+#ifdef Py_GIL_DISABLED
+    // The free-threaded GC doesn't keep objects in lists.
+    return 0;
+#else
+    PyTypeObject *tp = Py_TYPE(iterable);
+    if (tp->tp_flags & (Py_TPFLAGS_LIST_SUBCLASS
+                        | Py_TPFLAGS_TUPLE_SUBCLASS
+                        | Py_TPFLAGS_DICT_SUBCLASS
+                        | Py_TPFLAGS_UNICODE_SUBCLASS))
+    {
+        return 0;
+    }
+    return !(tp == &PySet_Type || tp == &PyFrozenSet_Type ||
+             tp == &PyRange_Type || tp == &PyDictKeys_Type ||
+             tp == &PyDictValues_Type);
+#endif
+}
+
+static void set_swap_bodies(PySetObject *a, PySetObject *b);
+
+// Track 'so', a new empty set, before a fill.  Returns 'so' (NULL if NULL).
+static PyObject *
+track_early_set(PyObject *so)
+{
+    if (so != NULL) {
+        _PyObject_GC_TRACK(so);
+    }
+    return so;
+}
+
+// Finish a fill: move the contents of 'filled' (complete, untracked) into
+// 'early' (the empty set tracked before the fill, of the same type) and
+// return it, or return 'filled', tracked, if 'early' was kept or changed.
+// Steals both references.
+static PyObject *
+take_filled_set(PyObject *early, PyObject *filled)
+{
+    PySetObject *so = (PySetObject *)early;
+    assert(Py_IS_TYPE(early, Py_TYPE(filled)));
+    if (_PyObject_IsUniquelyReferenced(early)
+        && so->weakreflist == NULL
+        && so->fill == 0
+        && so->hash == -1)
+    {
+        set_swap_bodies(so, (PySetObject *)filled);
+        Py_DECREF(filled);
+        return early;
+    }
+    Py_DECREF(early);
+    _PyObject_GC_TRACK(filled);
+    return filled;
+}
+
 static PyObject *
 make_new_set(PyTypeObject *type, PyObject *iterable)
 {
+    if (iterable != NULL
+        && (type == &PySet_Type || type == &PyFrozenSet_Type)
+        && fill_may_create_tracked_elements(iterable))
+    {
+        PyObject *early = track_early_set(make_new_set_untracked(type, NULL));
+        if (early == NULL) {
+            return NULL;
+        }
+        PyObject *filled = make_new_set_untracked(type, iterable);
+        if (filled == NULL) {
+            Py_DECREF(early);
+            return NULL;
+        }
+        return take_filled_set(early, filled);
+    }
     PyObject *so = make_new_set_untracked(type, iterable);
     if (so != NULL) {
         _PyObject_GC_TRACK(so);
@@ -1661,20 +1744,37 @@ set_union_impl(PySetObject *so, PyObject * const *others,
     PyObject *other;
     Py_ssize_t i;
 
+    PyObject *early = NULL;
+
     result = (PySetObject *)make_new_set_basetype_untracked(Py_TYPE(so),
                                                             (PyObject *)so);
     if (result == NULL)
         return NULL;
 
+    for (i = 0; i < others_length; i++) {
+        if (fill_may_create_tracked_elements(others[i])) {
+            early = track_early_set(
+                make_new_set_untracked(Py_TYPE(result), NULL));
+            if (early == NULL) {
+                Py_DECREF(result);
+                return NULL;
+            }
+            break;
+        }
+    }
     for (i = 0; i < others_length; i++) {
         other = others[i];
         if ((PyObject *)so == other)
             continue;
         if (set_update_local(result, other)) {
             Py_DECREF(result);
+            Py_XDECREF(early);
             return NULL;
         }
     }
+    if (early != NULL) {
+        return take_filled_set(early, (PyObject *)result);
+    }
     _PyObject_GC_TRACK(result);
     return (PyObject *)result;
 }
@@ -1719,6 +1819,7 @@ set_intersection(PySetObject *so, PyObject *other)
 {
     PySetObject *result;
     PyObject *key, *it, *tmp;
+    PyObject *early = NULL;
     Py_hash_t hash;
     int rv;
 
@@ -1762,9 +1863,17 @@ set_intersection(PySetObject *so, PyObject *other)
         return (PyObject *)result;
     }
 
+    if (fill_may_create_tracked_elements(other)) {
+        early = track_early_set(make_new_set_untracked(Py_TYPE(result), NULL));
+        if (early == NULL) {
+            Py_DECREF(result);
+            return NULL;
+        }
+    }
     it = PyObject_GetIter(other);
     if (it == NULL) {
         Py_DECREF(result);
+        Py_XDECREF(early);
         return NULL;
     }
 
@@ -1788,14 +1897,19 @@ set_intersection(PySetObject *so, PyObject *other)
     Py_DECREF(it);
     if (PyErr_Occurred()) {
         Py_DECREF(result);
+        Py_XDECREF(early);
         return NULL;
     }
+    if (early != NULL) {
+        return take_filled_set(early, (PyObject *)result);
+    }
     _PyObject_GC_TRACK(result);
     return (PyObject *)result;
   error:
     Py_DECREF(it);
     Py_DECREF(result);
     Py_DECREF(key);
+    Py_XDECREF(early);
     return NULL;
 }
 
@@ -2357,19 +2471,29 @@ static PyObject *
 set_symmetric_difference_impl(PySetObject *so, PyObject *other)
 /*[clinic end generated code: output=270ee0b5d42b0797 input=8c29b0be90d47feb]*/
 {
+    PyObject *early = NULL;
     PySetObject *result =
         (PySetObject *)make_new_set_basetype_untracked(Py_TYPE(so), NULL);
     if (result == NULL) {
         return NULL;
     }
-    if (set_update_lock_held(result, other) < 0) {
-        Py_DECREF(result);
-        return NULL;
+    if (fill_may_create_tracked_elements(other)) {
+        early = track_early_set(make_new_set_untracked(Py_TYPE(result), NULL));
+        if (early == NULL) {
+            Py_DECREF(result);
+            return NULL;
+        }
     }
-    if (set_symmetric_difference_update_set(result, so) < 0) {
+    if (set_update_lock_held(result, other) < 0
+        || set_symmetric_difference_update_set(result, so) < 0)
+    {
         Py_DECREF(result);
+        Py_XDECREF(early);
         return NULL;
     }
+    if (early != NULL) {
+        return take_filled_set(early, (PyObject *)result);
+    }
     _PyObject_GC_TRACK(result);
     return (PyObject *)result;
 }
