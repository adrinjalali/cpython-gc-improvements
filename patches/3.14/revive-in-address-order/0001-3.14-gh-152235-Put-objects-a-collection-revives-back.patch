@@ -0,0 +1,5 @@
+Fix full garbage collections becoming up to ten times slower after a large
+:class:`set` or :class:`frozenset` becomes the only owner of its elements, as
+when it is built from a generator or from a list that then goes away.  Objects
+that a collection finds reachable only through such a container are now put
+back in memory order rather than in its traversal order.
diff --git a/Python/gc.c b/Python/gc.c
index 4692826..dcbb566 100644
--- a/Python/gc.c
+++ b/Python/gc.c
@@ -567,6 +567,77 @@ visit_reachable(PyObject *op, void *arg)
  * But _gc_next in unreachable list has NEXT_MASK_UNREACHABLE flag.
  * So we can not gc_list_* functions for unreachable until we remove the flag.
  */
+static int
+gc_head_address_cmp(const void *a, const void *b)
+{
+    uintptr_t x = (uintptr_t)*(PyGC_Head *const *)a;
+    uintptr_t y = (uintptr_t)*(PyGC_Head *const *)b;
+    return (x > y) - (x < y);
+}
+
+/* visit_reachable() appends the objects it moves back from 'unreachable' to
+ * the end of 'young' in the order their referrer's tp_traverse visits them.
+ * For a set or frozenset that is hash order, so after one collection its
+ * elements sit in the list in random memory order, and every later
+ * collection walks them that way (gh-152235).  Put each such batch -- the
+ * objects after 'last', which was the end of 'young' before the traversal --
+ * in address order instead.  They are still behind their referrer, so later
+ * collections don't move them again.
+ */
+static void
+gc_sort_revived(PyGC_Head *last, PyGC_Head *young)
+{
+    Py_ssize_t n = 0;
+    int sorted = 1;
+    for (PyGC_Head *gc = GC_NEXT(last); gc != young; gc = GC_NEXT(gc)) {
+        PyGC_Head *next = GC_NEXT(gc);
+        if (next != young && (uintptr_t)next < (uintptr_t)gc) {
+            sorted = 0;
+        }
+        n++;
+    }
+    if (sorted) {
+        return;
+    }
+    // Most batches are a container's few elements: sort those in place.
+    PyGC_Head *small[32];
+    PyGC_Head **heads = small;
+    if (n > (Py_ssize_t)Py_ARRAY_LENGTH(small)) {
+        heads = PyMem_RawMalloc(n * sizeof(PyGC_Head *));
+        if (heads == NULL) {
+            return;  // keep the traversal order
+        }
+    }
+    Py_ssize_t i = 0;
+    for (PyGC_Head *gc = GC_NEXT(last); gc != young; gc = GC_NEXT(gc)) {
+        heads[i++] = gc;
+    }
+    if (heads == small) {
+        for (i = 1; i < n; i++) {
+            PyGC_Head *x = heads[i];
+            Py_ssize_t j = i;
+            for (; j > 0 && (uintptr_t)heads[j - 1] > (uintptr_t)x; j--) {
+                heads[j] = heads[j - 1];
+            }
+            heads[j] = x;
+        }
+    }
+    else {
+        qsort(heads, n, sizeof(PyGC_Head *), gc_head_address_cmp);
+    }
+    // The prev links of these objects hold gc_refs until they are scanned,
+    // so only the next links (and the end of 'young') are relinked.
+    _PyGCHead_SET_NEXT(last, heads[0]);
+    for (i = 0; i < n - 1; i++) {
+        _PyGCHead_SET_NEXT(heads[i], heads[i + 1]);
+    }
+    _PyGCHead_SET_NEXT(heads[n - 1], young);
+    young->_gc_prev = (uintptr_t)heads[n - 1];
+    if (heads != small) {
+        PyMem_RawFree(heads);
+    }
+}
+
 static void
 move_unreachable(PyGC_Head *young, PyGC_Head *unreachable)
 {
@@ -599,9 +670,13 @@ move_unreachable(PyGC_Head *young, PyGC_Head *unreachable)
                                       "refcount is too small");
             // NOTE: visit_reachable may change gc->_gc_next when
             // young->_gc_prev == gc.  Don't do gc = GC_NEXT(gc) before!
+            PyGC_Head *last = (PyGC_Head *)young->_gc_prev;
             (void) traverse(op,
                     visit_reachable,
                     (void *)young);
+            if ((PyGC_Head *)young->_gc_prev != last) {
+                gc_sort_revived(last, young);
+            }
             // relink gc_prev to prev element.
             _PyGCHead_SET_PREV(gc, prev);
             // gc is not COLLECTING state after here.
