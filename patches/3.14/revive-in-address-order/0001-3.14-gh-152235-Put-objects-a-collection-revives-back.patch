diff --git a/Lib/test/test_gc.py b/Lib/test/test_gc.py
index 496b4fe..2163421 100644
--- a/Lib/test/test_gc.py
+++ b/Lib/test/test_gc.py
@@ -862,6 +862,19 @@ def test_get_objects(self):
                 any(l is element for element in gc.get_objects())
         )
 
+    @requires_gil_enabled('need generational GC')
+    def test_revived_objects_in_address_order(self):
+        # gh-152235: objects that a collection finds reachable only through a
+        # set (their other owner went away) are put back in address order,
+        # rather than in the set's hash order, which scatters them in memory.
+        class K:
+            pass
+        s = set([K() for _ in range(1000)])
+        gc.collect()
+        ids = [id(o) for o in gc.get_objects(generation=2) if type(o) is K]
+        self.assertEqual(len(ids), len(s))
+        self.assertEqual(ids, sorted(ids))
+
     @requires_gil_enabled('need generational GC')
     def test_get_objects_generations(self):
         gc.collect()
